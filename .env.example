# SIH Government Service Integration Platform — Environment Configuration Template
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env for local deployment and override with production secrets.

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
# Leave blank for in-memory fallback mode (e.g. offline testing/demo)
# Or provide standard PostgreSQL connection string:
# Local: postgresql://postgres:postgres@localhost:5432/egov_bridge
# Cloud (Supabase/Neon/Render): postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=
PG_SSL=false
PG_MAX_CONNECTIONS=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# API Gateway Security & Rate Limiting
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX=120
GATEWAY_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Inter-Department Data Exchange (Phase 10)
DATA_EXCHANGE_TIMEOUT_SECONDS=60

# Mock Government API Endpoints (Local Sandbox Emulation)
MOCK_NSP_API_URL=https://mock-gateway.gov.local/nsp/v1
MOCK_MYSCHEME_API_URL=https://mock-gateway.gov.local/myscheme/v1
MOCK_NCS_API_URL=https://mock-gateway.gov.local/ncs/v1
MOCK_PIB_API_URL=https://mock-gateway.gov.local/pib/v1

# Federated Government Department Systems (From config/external-apis.json)
EDUCATION_API_URL=https://api.education.gov.mock
EDUCATION_API_KEY=placeholder_education_api_key

INCOME_API_URL=https://api.revenue.gov.mock
INCOME_API_KEY=placeholder_income_api_key

HEALTH_API_URL=https://api.health.gov.mock
HEALTH_API_KEY=placeholder_health_api_key

LAND_API_URL=https://api.landrecords.gov.mock
LAND_API_KEY=placeholder_land_api_key

TRANSPORT_API_URL=https://api.transport.gov.mock
TRANSPORT_API_KEY=placeholder_transport_api_key

SCHOLARSHIP_API_URL=https://api.scholarships.gov.mock
SCHOLARSHIP_API_KEY=placeholder_scholarship_api_key

CHATBOT_API_URL=https://api.ai-gateway.gov.mock
LLM_API_KEY=placeholder_llm_api_key
