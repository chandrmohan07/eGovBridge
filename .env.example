# ==============================================================================
# SIH Government Service Integration Platform — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' (do NOT commit .env to version control).
# 2. Fill in local configuration values or mock URLs for development.
# 3. Never hard-code secret keys or credentials in source files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih_gov_platform

# ------------------------------------------------------------------------------
# 3. Security & Authentication (Backend Server-Side Only)
# ------------------------------------------------------------------------------
# Replace with a cryptographically secure random string in production
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 4. Department Mock / External API Endpoints (See config/external-apis.json)
# ------------------------------------------------------------------------------
# Education Department Integration (Mock / Sandbox)
EDUCATION_API_URL=http://localhost:5000/api/v1/mock/education
EDUCATION_API_KEY=mock_education_api_key_for_testing

# Revenue / Income Department Integration (Mock / Sandbox)
INCOME_API_URL=http://localhost:5000/api/v1/mock/income
INCOME_API_KEY=mock_income_api_key_for_testing

# Scholarship Department Integration (Mock / Sandbox)
SCHOLARSHIP_API_URL=http://localhost:5000/api/v1/mock/scholarship
SCHOLARSHIP_API_KEY=mock_scholarship_api_key_for_testing

# Health Department Integration (Planned / Disabled by default)
HEALTH_API_URL=http://localhost:5000/api/v1/mock/health
HEALTH_API_KEY=mock_health_api_key_for_testing

# Land Records Department Integration (Planned / Disabled by default)
LAND_API_URL=http://localhost:5000/api/v1/mock/land
LAND_API_KEY=mock_land_api_key_for_testing

# Transport Department Integration (Planned / Disabled by default)
TRANSPORT_API_URL=http://localhost:5000/api/v1/mock/transport
TRANSPORT_API_KEY=mock_transport_api_key_for_testing

# ------------------------------------------------------------------------------
# 5. AI Government Citizen Assistant (Chatbot Gateway)
# ------------------------------------------------------------------------------
# Server-side endpoint or provider URL for grounded government chatbot
CHATBOT_API_URL=http://localhost:5000/api/v1/mock/chatbot
LLM_API_KEY=optional_external_llm_api_key

# ------------------------------------------------------------------------------
# 6. Notification Channels
# ------------------------------------------------------------------------------
PORTAL_NOTIFICATION_ENABLED=true
EMAIL_SERVICE_ENABLED=false
SMS_SERVICE_ENABLED=false

# ------------------------------------------------------------------------------
# 7. Department Integration Adapter Toggles (Phase 8)
# ------------------------------------------------------------------------------
IDENTITY_ADAPTER_ENABLED=true
EDUCATION_ADAPTER_ENABLED=true
HEALTH_ADAPTER_ENABLED=true
REVENUE_ADAPTER_ENABLED=true
TRANSPORT_ADAPTER_ENABLED=true
PFMS_ADAPTER_ENABLED=true

# ------------------------------------------------------------------------------
# 8. Secure Inter-Department Data Exchange (Phase 10)
# ------------------------------------------------------------------------------
DATA_EXCHANGE_TIMEOUT_SECONDS=60
MAX_EXCHANGE_RETRIES=2
